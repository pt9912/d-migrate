{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pt9912/d-migrate/docs/schema.json",
  "title": "d-migrate Schema",
  "description": "Neutrales, datenbankunabhaengiges Schema-Format fuer d-migrate",
  "type": "object",
  "required": ["schema_format", "name", "version"],
  "additionalProperties": false,
  "properties": {
    "schema_format": {
      "type": "string",
      "const": "1.0",
      "description": "Format-Version (immer \"1.0\")"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Schema-Name"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Anwendungs-Schema-Version (z.B. \"1.0.0\")"
    },
    "description": {
      "type": "string",
      "description": "Optionale Beschreibung"
    },
    "encoding": {
      "type": "string",
      "default": "utf-8",
      "description": "Standard-Encoding"
    },
    "locale": {
      "type": "string",
      "description": "Standard-Locale (z.B. \"de_DE\")"
    },
    "custom_types": {
      "type": "object",
      "description": "Benutzerdefinierte Typen (Enum, Composite, Domain)",
      "additionalProperties": { "$ref": "#/$defs/customType" }
    },
    "tables": {
      "type": "object",
      "description": "Tabellen-Definitionen",
      "additionalProperties": { "$ref": "#/$defs/table" }
    },
    "procedures": {
      "type": "object",
      "description": "Stored Procedures",
      "additionalProperties": { "$ref": "#/$defs/procedure" }
    },
    "functions": {
      "type": "object",
      "description": "User-Defined Functions",
      "additionalProperties": { "$ref": "#/$defs/function" }
    },
    "views": {
      "type": "object",
      "description": "Views und Materialized Views",
      "additionalProperties": { "$ref": "#/$defs/view" }
    },
    "triggers": {
      "type": "object",
      "description": "Trigger",
      "additionalProperties": { "$ref": "#/$defs/trigger" }
    },
    "sequences": {
      "type": "object",
      "description": "Explizit definierte Sequenzen",
      "additionalProperties": { "$ref": "#/$defs/sequence" }
    }
  },
  "$defs": {
    "table": {
      "type": "object",
      "required": ["columns", "primary_key"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "columns": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/column" }
        },
        "primary_key": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Primaerschluessel-Spalten"
        },
        "indices": {
          "type": "array",
          "items": { "$ref": "#/$defs/index" }
        },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/constraint" }
        },
        "partitioning": { "$ref": "#/$defs/partitioning" },
        "metadata": { "$ref": "#/$defs/tableMetadata" }
      }
    },
    "tableMetadata": {
      "type": "object",
      "additionalProperties": false,
      "description": "Physische Tabellen-Metadaten, primaer reverse-generiert",
      "properties": {
        "engine": {
          "type": ["string", "null"],
          "description": "MySQL-Tabellen-Engine (z.B. InnoDB)"
        },
        "without_rowid": {
          "type": "boolean",
          "default": false,
          "description": "SQLite WITHOUT ROWID-Tabelle"
        }
      }
    },
    "column": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "identifier", "text", "char", "integer", "smallint", "biginteger",
            "float", "decimal", "boolean", "datetime", "date", "time",
            "uuid", "json", "xml", "binary", "email", "enum", "array", "geometry",
            "fulltext"
          ],
          "description": "Einer der neutralen Typen (vollstaendige Liste: neutral-model-spec.md Abschnitt 3.1)"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "description": "Physische Spaltenposition (1-basiert) aus der Quelle. Erhaelt die Ordinalreihenfolge ueber Reverse/Generate. Optional; fehlt bei hand-authored Schemata (dann gilt die Reihenfolge im Dokument)."
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "NOT NULL"
        },
        "unique": {
          "type": "boolean",
          "default": false,
          "description": "UNIQUE-Constraint"
        },
        "default": {
          "description": "Default-Wert (String, Zahl, Boolean oder Funktionsname)",
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" }
          ]
        },
        "auto_increment": {
          "type": "boolean",
          "description": "Nur bei type: identifier"
        },
        "max_length": {
          "type": "integer",
          "minimum": 1,
          "description": "Nur bei type: text"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "description": "Nur bei type: char (Pflicht)"
        },
        "precision": {
          "type": "integer",
          "minimum": 1,
          "description": "Nur bei type: decimal (Pflicht)"
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "description": "Nur bei type: decimal (Pflicht)"
        },
        "float_precision": {
          "type": "string",
          "enum": ["single", "double"],
          "default": "double",
          "description": "Nur bei type: float"
        },
        "timezone": {
          "type": "boolean",
          "default": false,
          "description": "Nur bei type: datetime — WITH TIME ZONE"
        },
        "values": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Nur bei type: enum — Inline-Werte"
        },
        "ref_type": {
          "type": "string",
          "description": "Nur bei type: enum — Verweis auf custom_types"
        },
        "element_type": {
          "type": "string",
          "description": "Nur bei type: array (Pflicht)"
        },
        "geometry_type": {
          "type": "string",
          "enum": [
            "geometry", "point", "linestring", "polygon",
            "multipoint", "multilinestring", "multipolygon", "geometrycollection"
          ],
          "default": "geometry",
          "description": "Nur bei type: geometry (Spatial)"
        },
        "srid": {
          "type": "integer",
          "minimum": 1,
          "description": "Nur bei type: geometry — Spatial Reference System Identifier (> 0)"
        },
        "references": { "$ref": "#/$defs/reference" }
      }
    },
    "reference": {
      "type": "object",
      "required": ["table", "column"],
      "additionalProperties": false,
      "properties": {
        "table": {
          "type": "string",
          "description": "Referenzierte Tabelle"
        },
        "column": {
          "type": "string",
          "description": "Referenzierte Spalte"
        },
        "on_delete": { "$ref": "#/$defs/referentialAction" },
        "on_update": { "$ref": "#/$defs/referentialAction" }
      }
    },
    "referentialAction": {
      "type": "string",
      "enum": ["restrict", "cascade", "set_null", "set_default", "no_action"]
    },
    "index": {
      "type": "object",
      "required": ["columns"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "columns": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "$ref": "#/$defs/indexColumn" }
            ]
          },
          "minItems": 1
        },
        "type": {
          "type": "string",
          "enum": ["btree", "hash", "gin", "gist", "brin", "spgist", "spatial"],
          "default": "btree"
        },
        "unique": {
          "type": "boolean",
          "default": false
        },
        "where": { "type": "string", "minLength": 1 }
      }
    },
    "indexColumn": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "direction": {
          "type": "string",
          "enum": ["asc", "desc"]
        },
        "prefix_length": {
          "type": "integer",
          "minimum": 1,
          "description": "MySQL prefix-index key length (col(n)); omit to index the full column."
        }
      }
    },
    "constraint": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["check", "unique", "exclude", "foreign_key"]
        },
        "columns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expression": {
          "type": "string",
          "description": "Nur bei type: check"
        },
        "references": {
          "type": "object",
          "required": ["table", "columns"],
          "additionalProperties": false,
          "properties": {
            "table": { "type": "string" },
            "columns": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "on_delete": { "$ref": "#/$defs/referentialAction" },
            "on_update": { "$ref": "#/$defs/referentialAction" }
          },
          "description": "Nur bei type: foreign_key"
        }
      }
    },
    "partitioning": {
      "type": "object",
      "required": ["type", "key"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["range", "hash", "list"]
        },
        "key": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "partitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "default": {
                "type": "boolean",
                "default": false,
                "description": "DEFAULT-Partition (Catch-all); schliesst from/to/values/modulus aus"
              },
              "from": {
                "type": "array",
                "items": { "type": "string" },
                "description": "RANGE untere Grenze (Bound-Tupel; Sentinels MINVALUE/MAXVALUE)"
              },
              "to": {
                "type": "array",
                "items": { "type": "string" },
                "description": "RANGE obere Grenze (Bound-Tupel; Sentinels MINVALUE/MAXVALUE)"
              },
              "values": {
                "type": "array",
                "items": { "type": "string" },
                "description": "LIST-Werte"
              },
              "modulus": { "type": "integer", "description": "HASH-Modulus" },
              "remainder": { "type": "integer", "description": "HASH-Remainder" },
              "indices": {
                "type": "array",
                "items": { "$ref": "#/$defs/index" },
                "description": "Kind-lokale Indizes der Partition (nicht vom Parent propagiert)"
              }
            }
          }
        }
      }
    },
    "customType": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["enum", "composite", "domain"]
        },
        "description": { "type": "string" },
        "values": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Nur bei kind: enum"
        },
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/column" },
          "description": "Nur bei kind: composite"
        },
        "base_type": {
          "type": "string",
          "description": "Nur bei kind: domain"
        },
        "precision": {
          "type": "integer",
          "description": "Nur bei kind: domain (decimal)"
        },
        "scale": {
          "type": "integer",
          "description": "Nur bei kind: domain (decimal)"
        },
        "check": {
          "type": "string",
          "description": "Nur bei kind: domain — CHECK-Expression"
        }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "direction": {
          "type": "string",
          "enum": ["in", "out", "inout"],
          "default": "in"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tables": {
          "type": "array",
          "items": { "type": "string" }
        },
        "views": {
          "type": "array",
          "items": { "type": "string" }
        },
        "columns": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "projection_complete": {
          "type": "boolean",
          "default": true,
          "description": "Nur serialisiert, wenn abweichend von true"
        },
        "table_projection_status": { "$ref": "#/$defs/projectionStatus" },
        "column_projection_status": { "$ref": "#/$defs/projectionStatus" },
        "routine_projection_status": { "$ref": "#/$defs/projectionStatus" }
      }
    },
    "projectionStatus": {
      "type": "string",
      "enum": [
        "complete", "empty_verified", "incomplete_privilege",
        "incomplete_object_missing", "unknown"
      ]
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "language": { "type": "string" },
        "body": { "type": "string" },
        "dependencies": { "$ref": "#/$defs/dependencies" },
        "source_dialect": { "type": "string" }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "returns": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string" },
            "precision": { "type": "integer" },
            "scale": { "type": "integer" }
          }
        },
        "language": { "type": "string" },
        "deterministic": { "type": "boolean" },
        "volatility": {
          "type": "string",
          "enum": ["immutable", "stable", "volatile"],
          "description": "PostgreSQL-Funktionsvolatilität (provolatile)"
        },
        "strict": {
          "type": "boolean",
          "description": "PostgreSQL STRICT / RETURNS NULL ON NULL INPUT"
        },
        "body": { "type": "string" },
        "dependencies": { "$ref": "#/$defs/dependencies" },
        "source_dialect": { "type": "string" }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "materialized": {
          "type": "boolean",
          "default": false
        },
        "refresh": {
          "type": "string",
          "enum": ["on_demand", "on_commit"]
        },
        "query": { "type": "string" },
        "columns": {
          "type": "array",
          "description": "Optionale sichtbare View-Signatur",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "required": ["name"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "type": { "type": "string" }
                }
              }
            ]
          }
        },
        "dependencies": { "$ref": "#/$defs/dependencies" },
        "source_dialect": { "type": "string" }
      }
    },
    "trigger": {
      "type": "object",
      "required": ["table", "event", "timing"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "table": { "type": "string" },
        "event": {
          "description": "Ein einzelnes DML-Event (Skalar) oder — für Multi-Event-Trigger wie PostgreSQLs INSERT OR UPDATE — eine nicht-leere Menge von Events (Array)",
          "oneOf": [
            {
              "type": "string",
              "enum": ["insert", "update", "delete"]
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["insert", "update", "delete"]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "timing": {
          "type": "string",
          "enum": ["before", "after", "instead_of"]
        },
        "for_each": {
          "type": "string",
          "enum": ["row", "statement"],
          "default": "row"
        },
        "condition": {
          "type": ["string", "null"],
          "description": "Optionale WHEN-Bedingung; null bedeutet keine Bedingung"
        },
        "body": { "type": "string" },
        "dependencies": { "$ref": "#/$defs/dependencies" },
        "source_dialect": { "type": "string" }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "start": {
          "type": "integer",
          "default": 1
        },
        "increment": {
          "type": "integer",
          "default": 1
        },
        "min_value": { "type": "integer" },
        "max_value": { "type": "integer" },
        "cycle": {
          "type": "boolean",
          "default": false
        },
        "cache": { "type": "integer" },
        "preserve_current_value": {
          "type": "boolean",
          "default": false,
          "description": "Runtime-Wert ueber Migration retten (opt-in)"
        }
      }
    }
  }
}

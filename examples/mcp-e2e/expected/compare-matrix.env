# Erwartungen fuer scripts/smoke-compare-matrix.sh — an die d-migrate-Version
# gebunden (EXPECT_VERSION), nicht „allgemein richtig".
#
# CELL_<QUELLE>_<ZIEL>   Zahl der Funde von schema_compare (= schema_compare_start)
# CODES_<QUELLE>_<ZIEL>  die Codes dieser Funde mit Anzahl
# INVALID/E012-introducer: das Reverse der Quelle ist ungueltig (MySQL legt
#   String-Literale in CHECKs mit Zeichensatz-Introducer ab; Reader-Befund,
#   Posten 4 des Compare-Slices, im Reader-Slice C1/P6). Verschwindet der
#   Zustand, misst die Zelle wieder — neu pinnen.
#
# Bei einem Versionssprung oder einer gewollten Aenderung: laufen lassen, die
# Abweichungen pruefen, mit `--update-expectations` bewusst neu pinnen und den
# Diff dieser Datei lesen. Die Waechter (Werkzeug = Job, keine Name-/Versions-,
# Schreibweise- oder Sequenznamen-Funde, lesbare Form, Reverse-Report der Art
# REVERSE_REPORT mit R205 fuer MySQL) sind versionsunabhaengig und werden nie
# gepinnt; ein Lauf mit einem solchen Verstoss schreibt diese Datei nicht.
#
# Die Zellen gelten fuer den Server mit `reverse.mysql.autoincrement_syntax:
# identity` (der Lauf setzt es): PostgreSQL -> MySQL meldet die
# Identity-Spalte deshalb nicht.
#
# Gemessen: 2026-09-17, Arbeitsstand des Compare-Slices (sechster
# Bauabschnitt), d-migrate:dev; PostgreSQL 18.6, MySQL 9.7.2,
# SQL Server 2025, SQLite 3.45 (Host). Oracle nicht gemessen.
CELL_MSSQL_MYSQL="APPLY-FAIL"
CELL_MSSQL_POSTGRESQL="APPLY-FAIL"
CELL_MSSQL_SQLITE="9"
CELL_MYSQL_MSSQL="INVALID"
CELL_MYSQL_POSTGRESQL="INVALID"
CELL_MYSQL_SQLITE="INVALID"
CELL_POSTGRESQL_MSSQL="5"
CELL_POSTGRESQL_MYSQL="6"
CELL_POSTGRESQL_SQLITE="13"
CELL_SQLITE_MSSQL="APPLY-FAIL"
CELL_SQLITE_MYSQL="APPLY-FAIL"
CELL_SQLITE_POSTGRESQL="3"
CODES_MSSQL_MYSQL="apply:ERROR 1064"
CODES_MSSQL_POSTGRESQL="apply:syntax error at or near "[""
CODES_MSSQL_SQLITE="TABLE_COLUMN_GENERATION_CHANGED:1 TABLE_COLUMN_TYPE_CHANGED:8"
CODES_MYSQL_MSSQL="E012-introducer"
CODES_MYSQL_POSTGRESQL="E012-introducer"
CODES_MYSQL_SQLITE="E012-introducer"
CODES_POSTGRESQL_MSSQL="TABLE_COLUMN_GENERATION_CHANGED:2 TABLE_CONSTRAINT_REMOVED:3"
CODES_POSTGRESQL_MYSQL="TABLE_COLUMN_GENERATION_CHANGED:1 TABLE_CONSTRAINT_CHANGED:1 TABLE_CONSTRAINT_REMOVED:3 TABLE_INDEX_REMOVED:1"
CODES_POSTGRESQL_SQLITE="TABLE_COLUMN_GENERATION_CHANGED:2 TABLE_COLUMN_TYPE_CHANGED:8 TABLE_CONSTRAINT_REMOVED:3"
CODES_SQLITE_MSSQL="apply:Msg 2714"
CODES_SQLITE_MYSQL="apply:ERROR 1170"
CODES_SQLITE_POSTGRESQL="TABLE_CONSTRAINT_CHANGED:2 W137:1"
EXPECT_VERSION="1.8.0-SNAPSHOT"

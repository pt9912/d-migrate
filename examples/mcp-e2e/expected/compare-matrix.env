# Erwartungen fuer scripts/smoke-compare-matrix.sh — an die d-migrate-Version
# gebunden (EXPECT_VERSION), nicht „allgemein richtig".
#
# CELL_<QUELLE>_<ZIEL>   Zahl der Funde von schema_compare (= schema_compare_start)
# CODES_<QUELLE>_<ZIEL>  die Codes dieser Funde mit Anzahl
# INVALID/E012-introducer: das Reverse der Quelle ist ungueltig (MySQL legte
#   String-Literale in CHECKs mit Zeichensatz-Introducer ab). Seit der
#   MySQL-Reader den Servertext neutralisiert (spec/type-mapping.md, 4.5) tritt
#   der Zustand nicht mehr auf, die MySQL-Zeile misst. Die Erkennung bleibt im
#   Skript: kommt der Zustand zurueck, weicht die Zelle von ihrer Zahl ab.
#
# Bei einem Versionssprung oder einer gewollten Aenderung: laufen lassen, die
# Abweichungen pruefen, mit `--update-expectations` bewusst neu pinnen und den
# Diff dieser Datei lesen. Die Waechter (Werkzeug = Job, keine Name-/Versions-,
# Schreibweise- oder Sequenznamen-Funde, lesbare Form, Reverse-Report der Art
# REVERSE_REPORT mit R205 fuer MySQL) sind versionsunabhaengig und werden nie
# gepinnt; ein Lauf mit einem solchen Verstoss schreibt diese Datei nicht.
#
# Die Zellen gelten fuer den Server mit `reverse.mysql.autoincrement_syntax:
# identity` (der Lauf setzt es): PostgreSQL -> MySQL meldet die
# Identity-Spalte deshalb nicht.
#
# Gemessen: 2026-09-17, Arbeitsstand von Plan 1 des Reader-Umbrellas (E1, P6,
# P0, S4 und P12, mit den Seeds unter fixtures/seeds/), d-migrate:dev;
# PostgreSQL 18.6 (PostGIS-Image), MySQL 9.7.2, SQL Server 2025, SQLite 3.45
# (Host). Oracle nicht gemessen.
CELL_MSSQL_MYSQL="6"
CELL_MSSQL_POSTGRESQL="2"
CELL_MSSQL_SQLITE="11"
CELL_MYSQL_MSSQL="8"
CELL_MYSQL_POSTGRESQL="4"
CELL_MYSQL_SQLITE="11"
CELL_POSTGRESQL_MSSQL="11"
CELL_POSTGRESQL_MYSQL="11"
CELL_POSTGRESQL_SQLITE="22"
CELL_SQLITE_MSSQL="6"
CELL_SQLITE_MYSQL="APPLY-FAIL"
CELL_SQLITE_POSTGRESQL="3"
CODES_MSSQL_MYSQL="TABLE_COLUMN_GENERATION_CHANGED:1 TABLE_CONSTRAINT_CHANGED:2 TABLE_INDEX_REMOVED:1 W137:2"
CODES_MSSQL_POSTGRESQL="W137:2"
CODES_MSSQL_SQLITE="TABLE_COLUMN_GENERATION_CHANGED:1 TABLE_COLUMN_TYPE_CHANGED:10"
CODES_MYSQL_MSSQL="TABLE_COLUMN_GENERATION_CHANGED:1 TABLE_COLUMN_REQUIRED_TIGHTENED:1 TABLE_COLUMN_TYPE_CHANGED:2 TABLE_CONSTRAINT_CHANGED:2 W137:2"
CODES_MYSQL_POSTGRESQL="TABLE_CONSTRAINT_CHANGED:2 W137:2"
CODES_MYSQL_SQLITE="TABLE_COLUMN_GENERATION_CHANGED:1 TABLE_COLUMN_TYPE_CHANGED:10"
CODES_POSTGRESQL_MSSQL="TABLE_COLUMN_GENERATION_CHANGED:2 TABLE_COLUMN_TYPE_CHANGED:6 TABLE_CONSTRAINT_REMOVED:3"
CODES_POSTGRESQL_MYSQL="TABLE_COLUMN_GENERATION_CHANGED:2 TABLE_COLUMN_TYPE_CHANGED:4 TABLE_CONSTRAINT_CHANGED:1 TABLE_CONSTRAINT_REMOVED:3 TABLE_INDEX_REMOVED:1"
CODES_POSTGRESQL_SQLITE="TABLE_COLUMN_GENERATION_CHANGED:3 TABLE_COLUMN_TYPE_CHANGED:16 TABLE_CONSTRAINT_REMOVED:3"
CODES_SQLITE_MSSQL="TABLE_COLUMN_REQUIRED_TIGHTENED:1 TABLE_CONSTRAINT_CHANGED:2 TABLE_CONSTRAINT_REMOVED:2 W137:1"
CODES_SQLITE_MYSQL="apply:ERROR 1170"
CODES_SQLITE_POSTGRESQL="TABLE_CONSTRAINT_CHANGED:2 W137:1"
EXPECT_VERSION="1.8.0-SNAPSHOT"
GEN_CODES_MSSQL_MYSQL="E057:1"
GEN_CODES_MSSQL_POSTGRESQL=""
GEN_CODES_MSSQL_SQLITE="W200:2"
GEN_CODES_MYSQL_MSSQL="W140:1"
GEN_CODES_MYSQL_POSTGRESQL=""
GEN_CODES_MYSQL_SQLITE="W200:1"
GEN_CODES_POSTGRESQL_MSSQL="E053:4 W137:6 W140:1"
GEN_CODES_POSTGRESQL_MYSQL="E053:4 E057:1 W162:4"
GEN_CODES_POSTGRESQL_SQLITE="E053:4 W162:4 W200:3"
GEN_CODES_SQLITE_MSSQL="E057:2"
GEN_CODES_SQLITE_MYSQL="E057:1 W125:1"
GEN_CODES_SQLITE_POSTGRESQL=""
REPORT_CODES_MSSQL=""

# MCP-E2E-Harness environment — TEST ONLY, NOT FOR PRODUCTION.
#
# Plan: docs/planning/next/mcp-real-e2e-scope-matrix.md Teil B
#
# Usage: copy to `.env` (gitignored) before
#        `docker compose -f examples/mcp-e2e/docker-compose.yml up -d postgres`.
#        `make mcp-e2e-smoke` legt `.env` bei Bedarf selbst an.
#
# Die Ports sind bewusst hoch und mit 127.0.0.1 gebunden: sie sollen einen
# lokal laufenden Server nicht verdraengen.

# --- PostgreSQL -------------------------------------------------------
MCP_E2E_PG_DB=mcp_e2e
# Das Bein der Compare-Matrix fuer PostGIS **ausserhalb** des `search_path`
# (smoke-compare-matrix.sh, Schluessel REPORT_CODES_POSTGRESQL_NOSEARCHPATH).
# Eine zweite Datenbank auf demselben Dienst; der Lauf legt sie selbst an.
# Ohne Eintrag greift der Default aus docker-compose.yml.
MCP_E2E_PG_NOSP_DB=mcp_e2e_nosp
MCP_E2E_PG_USER=dmigrate
MCP_E2E_PG_PASSWORD=mcp-e2e-pw-change-me
MCP_E2E_PG_PORT=55435

# --- MySQL ------------------------------------------------------------
MCP_E2E_MY_DB=mcp_e2e
MCP_E2E_MY_USER=dmigrate
MCP_E2E_MY_PASSWORD=mcp-e2e-pw-change-me
MCP_E2E_MY_ROOT_PASSWORD=mcp-e2e-root-pw-change-me
MCP_E2E_MY_PORT=55336

# --- SQL Server -------------------------------------------------------
# Das SA-Passwort muss die Komplexitaetsregel erfuellen (Gross-, Klein-,
# Ziffern- und Sonderzeichen), sonst startet der Container nicht.
MCP_E2E_MS_DB=mcp_e2e
MCP_E2E_MS_PASSWORD=MCPe2e-Pa55word
MCP_E2E_MS_PORT=55143

# --- Oracle (nur unter `--profile oracle`) ----------------------------
MCP_E2E_ORA_DB=FREEPDB1
MCP_E2E_ORA_USER=dmigrate
MCP_E2E_ORA_PASSWORD=mcp-e2e-pw-change-me
MCP_E2E_ORA_PORT=55152

# --- SQLite -----------------------------------------------------------
# Kein Dienst: eine Datei im gemounteten out/-Verzeichnis. Der Pfad steht
# in docker-compose.yml, weil er relativ zum Container-Workdir ist.

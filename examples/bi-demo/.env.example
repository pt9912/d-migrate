# BI-Demo environment variables — DEMO ONLY, NOT FOR PRODUCTION.
#
# Spec: docs/planning/in-progress/bi-demo-compose.md §5.5
#
# Usage: copy to `.env` (which is gitignored) before
#        `docker compose -f examples/bi-demo/docker-compose.yml up -d`.
#        Die `bi-demo-*`-Make-Targets kommen mit BD.5.

# PostgreSQL — Demo-only credentials, NOT for production
POSTGRES_DB=dmigrate_demo
POSTGRES_USER=dmigrate
POSTGRES_PASSWORD=demo-pg-pw-change-me
POSTGRES_PORT=55432

# SeaweedFS S3 API — Demo-only credentials, NOT for production.
# Single Source of Truth: the seaweed-config one-shot renders
# /etc/seaweed/s3.json from these values into a named volume,
# and seaweed-init / aws-tools map them to AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY for the AWS CLI. Change here only;
# `docker compose down && docker compose up -d` to apply
# (seaweed server needs a restart to reload s3.json).
#
# No character restrictions: `"` and `\` are escaped before they
# reach the JSON heredoc (bash parameter expansion in
# seaweed-config); `:`, `@`, `/`, `?`, `#` are passed via env
# vars to the AWS CLI (no URL embedding). Any value a password
# manager would generate is accepted.
S3_ACCESS_KEY=demoaccesskey
S3_SECRET_KEY=demosecretkey
S3_API_PORT=59000
SEAWEED_MASTER_PORT=59001
S3_BUCKET=dmigrate-demo

# Metabase (genutzt ab Sub-Slice BD.3)
METABASE_PORT=3000

# Sample-DB-Harness environment — TEST ONLY, NOT FOR PRODUCTION.
#
# Plan: docs/planning/done/sample-db-integration-harness.md
#
# Usage: copy to `.env` (gitignored) before
#        `docker compose -f examples/sample-db/docker-compose.yml up -d`.
#        Die `sample-db-*`-Make-Targets legen `.env` bei Bedarf an.

# PostgreSQL — test-only credentials, NOT for production.
# POSTGRES_DB is the bootstrap DB; the source/target databases
# (pagila, pagila_target) are created by sql/00-init-databases.sql.
POSTGRES_DB=postgres
POSTGRES_USER=dmigrate
POSTGRES_PASSWORD=sample-db-pw-change-me
SAMPLE_DB_PG_PORT=55433
# PostGIS-Service (Phase 5, Spatial-Smoke) — eigener Port neben postgres.
SAMPLE_DB_POSTGIS_PORT=55434

# MySQL — test-only credentials, NOT for production (Phase 2, Cross-Dialect).
# MYSQL_DATABASE=sakila is the source DB (auto-created + granted to MYSQL_USER);
# pagila_target is added by sql-mysql/00-init-databases.sql. MYSQL_USER must
# not be 'root'.
MYSQL_ROOT_PASSWORD=sample-db-root-pw-change-me
MYSQL_DATABASE=sakila
MYSQL_USER=dmigrate
MYSQL_PASSWORD=sample-db-pw-change-me
SAMPLE_DB_MYSQL_PORT=33067

# MS SQL Server — test-only credentials, NOT for production (MSSQL-Leg,
# Pagila PG -> SQL Server). Das Image laeuft nur mit akzeptierter Microsoft-EULA
# (ACCEPT_EULA=Y, siehe docs/user/quality.md) und verlangt ein Passwort mit
# Gross-/Kleinbuchstabe, Ziffer und Sonderzeichen. Die Ziel-DB (pagila_target)
# legt smoke-cross-pg2ms.sh an — SQL Server hat kein initdb-Verzeichnis.
MSSQL_SA_PASSWORD=Sample_DB_Pw_Change_Me1
SAMPLE_DB_MSSQL_PORT=14434

# Phase 3 (Scale, Employees — opt-in/nightly). The employees source DB and
# the employees_my_target / employees_pg_target target DBs are created by
# smoke-scale.sh; the pinned Employees dumps are fetched on demand
# (FETCH_EMPLOYEES=1) into .cache/employees/. No extra credentials needed.
